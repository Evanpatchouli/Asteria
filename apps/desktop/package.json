{
  "name": "@asteria/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev --watch",
    "predev": "pnpm --filter @asteria/renderer... build",
    "presmoke": "pnpm --filter @asteria/renderer... build",
    "smoke": "electron-vite build && electron . --smoke-test",
    "start": "electron-vite preview",
    "typecheck": "tsc --project tsconfig.config.json --noEmit && tsc --project tsconfig.main.json --noEmit && tsc --project tsconfig.preload.json --noEmit && tsc --project tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@asteria/renderer": "workspace:*",
    "@asteria/shared": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  }
}
